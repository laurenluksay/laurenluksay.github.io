---
import { siteConfig } from "../config";
import SectionHeading from "./SectionHeading.astro";
---

<section id="about" class="px-6 sm:px-10 md:px-16 py-14 md:py-20 scroll-mt-16">
  <div class="max-w-5xl mx-auto">
    <SectionHeading title="About Me" />

    <p class="text-lg sm:text-xl md:text-2xl leading-relaxed text-gray-700">
      {siteConfig.aboutMe}
    </p>

    <div class="pt-8 flex flex-wrap gap-3">
      {
        siteConfig.skills.map((skill) => (
          <span class="px-3 sm:px-4 py-1.5 sm:py-2 bg-slate-200 text-gray-800 rounded-full text-sm sm:text-base font-medium transition-colors duration-300 hover:bg-slate-100">
            {skill}
          </span>
        ))
      }
    </div>
  </div>
</section>
