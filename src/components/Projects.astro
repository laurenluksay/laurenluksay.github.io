---
import { siteConfig } from "../config";
import ArrowIcon from "./ArrowIcon.astro";
import SectionHeading from "./SectionHeading.astro";

const hasProjects = siteConfig.projects && siteConfig.projects.length > 0;
---

{
  hasProjects && (
    <section id="projects" class="px-6 sm:px-10 md:px-16 py-14 md:py-20 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <SectionHeading title="Projects" />

        <div class="space-y-6">
          {siteConfig.projects.map((project) => {
            const Tag = project.link ? "a" : "div";
            const linkProps = project.link ? { href: project.link } : {};
            return (
              <Tag
                {...linkProps}
                class={`group block bg-white/70 rounded-2xl border border-gray-200 shadow-sm p-5 sm:p-6 md:p-7 transition-all duration-300 ${
                  project.link ? "hover:bg-white hover:shadow-lg hover:border-gray-300 hover:-translate-y-0.5" : ""
                }`}
              >
                {/* Header row: title + arrow */}
                <div class="flex items-start justify-between gap-3 mb-4">
                  <h3 class="text-lg sm:text-xl font-semibold text-gray-900">{project.name}</h3>
                  {project.link && <ArrowIcon />}
                </div>

                {/* Body: description + skills on the left, photo on the right */}
                <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1.2fr)_minmax(0,1fr)] gap-4 sm:gap-6 items-center">
                  <div class="min-w-0 space-y-3">
                    {project.description && (
                      <p class="text-sm sm:text-base text-gray-600 leading-relaxed">{project.description}</p>
                    )}
                    {project.skills && project.skills.length > 0 && (
                      <div class="flex flex-wrap gap-1.5 sm:gap-2">
                        {project.skills.map((skill) => (
                          <span class="px-2.5 sm:px-3 py-1 bg-gray-900 text-white rounded-md text-xs sm:text-sm font-medium">
                            {skill}
                          </span>
                        ))}
                      </div>
                    )}
                  </div>
                  {project.image && (
                    <div class="order-first sm:order-none flex justify-center sm:justify-end">
                      <img
                        src={project.image}
                        alt={project.name}
                        loading="lazy"
                        class="block w-auto max-w-full h-auto max-h-64 sm:max-h-72 rounded-xl border border-gray-200 shadow-sm"
                      />
                    </div>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )
}
