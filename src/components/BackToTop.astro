---
// Floating "back to top" button for writeup pages.
// Hidden at the top of the page; fades in once you've scrolled down.
---

<button
  id="back-to-top"
  type="button"
  aria-label="Back to top"
  class="group fixed bottom-6 right-6 z-40 w-11 h-11 rounded-full bg-gray-200 text-gray-800 border border-gray-300 shadow-lg flex items-center justify-center transition-all duration-300 hover:bg-gray-100 hover:text-black opacity-0 translate-y-3 pointer-events-none"
>
  <svg class="w-5 h-5 transition-transform duration-300 group-hover:-translate-y-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19V5M5 12l7-7 7 7" />
  </svg>
</button>

<script>
  const btn = document.getElementById("back-to-top");

  if (btn) {
    // How far down (in px) before the button appears
    const SHOW_AFTER = 400;
    const hiddenClasses = ["opacity-0", "translate-y-3", "pointer-events-none"];

    const update = () => {
      const hidden = window.scrollY < SHOW_AFTER;
      hiddenClasses.forEach((c) => btn.classList.toggle(c, hidden));
    };

    window.addEventListener("scroll", update, { passive: true });
    update();

    btn.addEventListener("click", () => {
      const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      window.scrollTo({ top: 0, behavior: reduceMotion ? "auto" : "smooth" });
    });
  }
</script>
