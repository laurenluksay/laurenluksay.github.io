---
import { siteConfig } from "../config";
import ArrowIcon from "./ArrowIcon.astro";
import SectionHeading from "./SectionHeading.astro";

const hasExperience = siteConfig.experience && siteConfig.experience.length > 0;
---

{
  hasExperience && (
    <section id="experience" class="px-6 sm:px-10 md:px-16 py-14 md:py-20 scroll-mt-16">
      <div class="max-w-5xl mx-auto">
        <SectionHeading title="Experience" />

        <div class="space-y-6">
          {siteConfig.experience.map((exp) => {
            const Tag = exp.link ? "a" : "div";
            const linkProps = exp.link ? { href: exp.link } : {};
            return (
              <Tag
                {...linkProps}
                class={`group block bg-white/70 rounded-2xl border border-gray-200 shadow-sm p-5 sm:p-6 md:p-7 transition-all duration-300 ${
                  exp.link ? "hover:bg-white hover:shadow-lg hover:border-gray-300 hover:-translate-y-0.5" : ""
                }`}
              >
                {/* Header row: role + team, date + arrow */}
                <div class="flex items-start justify-between gap-3 mb-4">
                  <div class="min-w-0">
                    <h3 class="text-lg sm:text-xl font-semibold text-gray-900">{exp.title}</h3>
                    <p class="text-base sm:text-lg" style={`color: ${siteConfig.accentColor}`}>{exp.company}</p>
                    <p class="text-sm text-gray-500 mt-0.5 sm:hidden">{exp.dateRange}</p>
                  </div>
                  <div class="flex items-center gap-4 shrink-0">
                    <span class="hidden sm:block text-sm text-gray-500 whitespace-nowrap">{exp.dateRange}</span>
                    {exp.link && <ArrowIcon />}
                  </div>
                </div>

                {/* Body: bullets on the left, logo on the right */}
                <div class="grid grid-cols-1 sm:grid-cols-[minmax(0,1.4fr)_minmax(0,1fr)] gap-4 sm:gap-6 items-center">
                  <ul class="space-y-2">
                    {exp.bullets.map((bullet) => (
                      <li class="flex items-start">
                        <span class="inline-block w-1.5 h-1.5 rounded-full mt-2 mr-3 flex-shrink-0" style={`background-color: ${siteConfig.accentColor}`} />
                        <span class="text-sm sm:text-base text-gray-600">{bullet}</span>
                      </li>
                    ))}
                  </ul>
                  {exp.image && (
                    <div class="order-first sm:order-none flex items-center justify-center rounded-xl bg-white border border-gray-100 p-4 h-32 sm:h-36">
                      <img src={exp.image} alt={exp.company} class="max-h-full max-w-full object-contain" loading="lazy" />
                    </div>
                  )}
                </div>
              </Tag>
            );
          })}
        </div>
      </div>
    </section>
  )
}
